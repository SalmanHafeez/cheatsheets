import numpy as np
from scipy.linalg import solve_triangular, lu as scipy_lu
# === LU-based solver without pivoting ===
def linSolveLU(A: np.ndarray, b: np.ndarray):
"""Solve A x = b using in-place LU factorization (no pivoting)."""
# Perform in-place LU factorization (A is overwritten)
L, U = lu(A)
# Forward substitution: L y = b
y = solve_triangular(L, b, lower=True, unit_diagonal=True)
# Backward substitution: U x = y
x = solve_triangular(U, y, lower=False)
return x
# === PLU-based solver with partial pivoting ===
def linSolvePLU(A: np.ndarray, b: np.ndarray):
"""Solve A x = b using in-place PLU factorization (partial pivoting)."""
# Perform in-place PLU factorization
P, L, U = plu(A)
# Apply permutation: P A = L U  use Pb
b_perm = P @ b
# Forward substitution: L y = Pb
y = solve_triangular(L, b_perm, lower=True, unit_diagonal=True)
# Backward substitution: U x = y
x = solve_triangular(U, y, lower=False)
return x
# === SciPy PLU-based solver ===
def linSolveScipyPLU(A: np.ndarray, b: np.ndarray):
"""Solve A x = b using SciPy's LU factorization (A = P L U)."""
# SciPy's convention: A = P L U
P, L, U = scipy_lu(A)
# Apply transpose permutation: L U x = P^T b
b_perm = P.T @ b
# Forward substitution: L y = P^T b
y = solve_triangular(L, b_perm, lower=True, unit_diagonal=True)
# Backward substitution: U x = y
